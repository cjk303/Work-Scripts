#!/usr/bin/env bash
#
# opensearch-sync.sh — pull indices from a READ-ONLY source OpenSearch into
# THIS (local/clone) cluster via native remote reindex.
#
#   (no args)   interactive sync: full backlog OR incremental, with a days floor
#   --fix       recovery: refill indices that are empty/absent locally but have
#               data on the source. Never drops anything.
#
# The source is only ever read. Every write goes to the LOCAL cluster.
#
# A same-host guard aborts if the source resolves to THIS machine, so you can
# never copy a cluster onto itself (which is what dropped data before).
#
# PREREQUISITE on THIS clone only, in opensearch.yml, then restart:
#     reindex.remote.whitelist: "SOURCE_IP:9200"
#     reindex.ssl.verification_mode: none
#
set -uo pipefail

FIX=0; [ "${1:-}" = "--fix" ] && FIX=1
LOCAL="https://localhost:9200"
have(){ command -v "$1" >/dev/null 2>&1; }
have python3 || { echo "python3 required"; exit 1; }
hr(){ printf '\n----- %s -----\n' "$1"; }

echo "host: $(hostname)   mode: $([ $FIX = 1 ] && echo RECOVERY --fix || echo sync)"

# ---- prompts ---------------------------------------------------------------
read -r -p "Source host/IP: "                   SRC_HOST
read -r -p "Source port [9200]: "               SRC_PORT; SRC_PORT=${SRC_PORT:-9200}
read -r -p "Source read user [admin]: "         SRC_USER; SRC_USER=${SRC_USER:-admin}
read -r -s -p "Source password: "               SRC_PASS; echo
read -r -s -p "Local (clone) admin password: "  LOC_PASS; echo
read -r -p "Index pattern [*]: "                 PAT;      PAT=${PAT:-*}
read -r -p "Timestamp field [@timestamp]: "      TS;       TS=${TS:-@timestamp}
DAYS=""; RUN="i"; IDOP="gt"
if [ $FIX = 0 ]; then
  read -r -p "Only data newer than N days (blank = all): " DAYS
  echo "Run type:  [f]ull backlog (replace each index within the window)"
  echo "           [i]ncremental  (add only docs newer than what's already local)"
  read -r -p "Run type [i]: " RUN; RUN=${RUN:-i}
  if [ "$RUN" = i ]; then
    read -r -p "Source docs use stable _ids (not auto-generated)? [y/N]: " SID
    [ "${SID:-N}" = y ] && IDOP="gte"
  fi
fi
read -r -p "Throttle req/s (-1 = unlimited) [2000]: " RPS;   RPS=${RPS:-2000}
read -r -p "Scroll batch size [2000]: "                BATCH; BATCH=${BATCH:-2000}

SRC="https://${SRC_HOST}:${SRC_PORT}"
SRC_AUTH="${SRC_USER}:${SRC_PASS}"
LOC_AUTH="admin:${LOC_PASS}"
export SRC SRC_USER SRC_PASS TS DAYS BATCH

cs(){ curl -sk -u "$SRC_AUTH" -H 'Content-Type: application/json' "$SRC/$1" "${@:2}"; }   # source: READ ONLY
cl(){ curl -sk -u "$LOC_AUTH" -H 'Content-Type: application/json' "$LOCAL/$1" "${@:2}"; } # local
jget(){ python3 -c "import sys,json;d=json.load(sys.stdin);print(d$1)" 2>/dev/null; }

# ---- same-host guard: refuse to copy a cluster onto itself -----------------
case "$SRC_HOST" in
  localhost|127.*|::1) echo "ABORT: source is loopback — that is THIS machine."; exit 1;;
esac
sip=$(getent hosts "$SRC_HOST" 2>/dev/null | awk '{print $1; exit}'); [ -z "$sip" ] && sip="$SRC_HOST"
for ip in $(hostname -I 2>/dev/null); do
  if [ "$ip" = "$sip" ]; then
    echo "ABORT: source ($SRC_HOST -> $sip) is THIS machine ($ip)."
    echo "       You'd be reading and writing the same cluster. Run this ON THE CLONE,"
    echo "       with the source pointing at the OTHER box."
    exit 1
  fi
done

# ---- helpers ---------------------------------------------------------------
make_query(){ LM="${1:-}" OP="${2:-gt}" python3 -c '
import os,json
ts=os.environ["TS"]; days=os.environ.get("DAYS","").strip()
lm=os.environ.get("LM","").strip(); op=os.environ.get("OP","gt")
f=[]
if days: f.append({"range":{ts:{"gte":"now-%sd"%days}}})
if lm:   f.append({"range":{ts:{op:lm}}})
print(json.dumps({"bool":{"filter":f}}) if f else "")'; }

make_body(){ Q="${1:-}" IDX="$2" python3 -c '
import os,json
b={"source":{"remote":{"host":os.environ["SRC"],"username":os.environ["SRC_USER"],
      "password":os.environ["SRC_PASS"],"socket_timeout":"5m","connect_timeout":"30s"},
      "index":os.environ["IDX"],"size":int(os.environ["BATCH"])},
   "dest":{"index":os.environ["IDX"]}}
q=os.environ.get("Q","").strip()
if q: b["source"]["query"]=json.loads(q)
print(json.dumps(b))'; }

poll(){ local tid="$1"
  while :; do
    local r; r=$(cl "_tasks/${tid}")
    local done cr tot; done=$(echo "$r" | jget "['completed']")
    cr=$(echo "$r" | jget "['task']['status']['created']")
    tot=$(echo "$r" | jget "['task']['status']['total']")
    [ "${tot:-0}" -gt 0 ] 2>/dev/null && printf '\r    %s / %s docs' "${cr:-0}" "$tot"
    if [ "$done" = "True" ]; then echo
      echo "$r" | python3 -c 'import sys,json
d=json.load(sys.stdin); r=d.get("response",{}); st=d.get("task",{}).get("status",{})
f=r.get("failures",[])
print("    created=%s updated=%s failures=%d"%(
  r.get("created",st.get("created","?")),r.get("updated",st.get("updated","?")),len(f)))
[print("      FAIL:",json.dumps(x)[:200]) for x in f[:5]]'
      break; fi
    sleep 5
  done; }

reindex_one(){ # reindex_one <index> <query-json-or-empty>
  local i="$1" q="$2"
  local body; body=$(make_body "$q" "$i")
  local resp; resp=$(cl "_reindex?wait_for_completion=false&requests_per_second=${RPS}&slices=auto" -XPOST -d "$body")
  local tid; tid=$(echo "$resp" | jget "['task']")
  if [ -z "${tid:-}" ]; then
    echo "  reindex did not start:"; echo "$resp" | head -c 500; echo
    echo "$resp" | grep -qi whitelist            && echo "  -> add source to reindex.remote.whitelist + restart clone."
    echo "$resp" | grep -qiE 'ssl|cert|handshake' && echo "  -> set reindex.ssl.verification_mode: none + restart clone."
    return 1
  fi
  echo "  task $tid"
  poll "$tid"
  cl "$i/_refresh" -o /dev/null
}

# ---- connectivity ----------------------------------------------------------
hr "CONNECTIVITY"
sc=$(cs '' -o /dev/null -w '%{http_code}'); lc=$(cl '' -o /dev/null -w '%{http_code}')
echo "source $SRC -> HTTP ${sc:-none}   local -> HTTP ${lc:-none}"
[ "$sc" = 200 ] && [ "$lc" = 200 ] || { echo "Both must be 200."; exit 1; }

mapfile -t IDX < <(cs "_cat/indices/${PAT}?h=index" | grep -v '^\.' | sort)
[ "${#IDX[@]}" -gt 0 ] || { echo "No non-system indices match '$PAT'."; exit 1; }

# ============================================================================
# FIX MODE: refill empty/absent local indices. Never drops.
# ============================================================================
if [ $FIX = 1 ]; then
  hr "PREFLIGHT (copy 1 doc to prove the link works)"
  pf=$(cl "_reindex" -XPOST -d "{\"source\":{\"remote\":{\"host\":\"$SRC\",\"username\":\"$SRC_USER\",
        \"password\":\"$SRC_PASS\"},\"index\":\"${IDX[0]}\",\"size\":1,\"max_docs\":1},
        \"dest\":{\"index\":\"zz-fixtest\"}}")
  created=$(echo "$pf" | jget "['created']")
  cl "zz-fixtest" -XDELETE -o /dev/null
  if [ "${created:-0}" != "1" ]; then
    echo "Preflight did NOT copy a doc. Response:"; echo "$pf" | head -c 600; echo
    echo "$pf" | grep -qi whitelist            && echo " -> add source to reindex.remote.whitelist + restart clone."
    echo "$pf" | grep -qiE 'ssl|cert|handshake' && echo " -> set reindex.ssl.verification_mode: none + restart clone."
    echo "Fix the prereq, then re-run --fix."; exit 1
  fi
  echo "preflight OK (copied 1 doc)"

  hr "SCAN: which indices need refilling"
  NEED=()
  printf '%-45s %14s %12s\n' "index" "source docs" "local docs"
  for i in "${IDX[@]}"; do
    sd=$(cs "$i/_count" | jget "['count']")
    if cl "$i" -o /dev/null -w '%{http_code}' | grep -q 200; then
      ld=$(cl "$i/_count" | jget "['count']")
    else ld=0; fi
    printf '%-45s %14s %12s\n' "$i" "${sd:-?}" "${ld:-0}"
    if [ "${ld:-0}" = 0 ] && [ "${sd:-0}" -gt 0 ] 2>/dev/null; then NEED+=("$i"); fi
  done
  [ "${#NEED[@]}" -gt 0 ] || { echo; echo "Nothing to fix — no empty index has source data."; exit 0; }
  echo; echo "Will refill: ${NEED[*]}"
  read -r -p "Proceed? [y/N]: " ok; [ "$ok" = y ] || { echo "Aborted."; exit 0; }

  for i in "${NEED[@]}"; do
    hr "REFILL  $i"
    reindex_one "$i" "" || continue
    echo "  verify: source=$(cs "$i/_count" | jget "['count']")  local=$(cl "$i/_count" | jget "['count']")"
  done
  hr "DONE (fix)"; exit 0
fi

# ============================================================================
# NORMAL MODE
# ============================================================================
RUN_NAME=$([ "$RUN" = f ] && echo "FULL backlog (REPLACE)" || echo "INCREMENTAL ($IDOP)")
FLOOR=$([ -n "${DAYS:-}" ] && echo "newer than ${DAYS}d" || echo "all history")
hr "PLAN: $RUN_NAME  |  window: $FLOOR  |  ${RPS} req/s  |  slices=auto"
printf '%-45s %14s   %s\n' "index" "src in window" "local now"
for i in "${IDX[@]}"; do
  q=$(make_query); sd=$(cs "$i/_count" -d "${q:+{\"query\":$q}}" | jget "['count']")
  ld=$(cl "$i" -o /dev/null -w '%{http_code}' | grep -q 200 && cl "$i/_count" | jget "['count']" || echo "(absent)")
  printf '%-45s %14s   %s\n' "$i" "${sd:-?}" "${ld:-?}"
done
if [ "$RUN" = f ]; then
  echo; echo "FULL mode DROPS each local index before copying. Data on the source is untouched,"
  echo "but anything already on the clone in these indices is replaced."
fi
read -r -p "Proceed? [y/N]: " ok; [ "$ok" = y ] || { echo "Aborted."; exit 0; }

for i in "${IDX[@]}"; do
  hr "$i"
  if [ "$RUN" = f ]; then
    cl "$i" -XDELETE -o /dev/null -w 'drop %{http_code}\n'
    cl "$i" -XPUT -d '{"settings":{"index":{"number_of_replicas":0,"refresh_interval":"-1"}}}' \
      -o /dev/null -w 'create %{http_code}\n'
    Q=$(make_query)
  else
    LM=$(cl "$i/_search?size=0" -d "{\"aggs\":{\"m\":{\"max\":{\"field\":\"$TS\"}}}}" \
         | jget "['aggregations']['m']['value_as_string']")
    [ -n "${LM:-}" ] && echo "    local max $TS = $LM (copying $IDOP that)" \
                     || echo "    local empty — copying full window"
    Q=$(make_query "${LM:-}" "$IDOP")
  fi

  reindex_one "$i" "$Q" || continue

  [ "$RUN" = f ] && cl "$i/_settings" -XPUT \
    -d '{"index":{"number_of_replicas":1,"refresh_interval":"1s"}}' -o /dev/null
  echo "  verify: local now = $(cl "$i/_count" | jget "['count']")"
done

hr "DONE"
echo "Re-run INCREMENTAL any time to catch up; it reads the local max $TS per index."
