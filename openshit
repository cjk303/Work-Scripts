#!/usr/bin/env bash
#
# opensearch-import-week.sh — safely import the last N days of records from a
# READ-ONLY source OpenSearch into THIS cluster. Built to be re-run freely.
#
# SPEED: remote reindex is single-stream per index (slices unsupported), so this
# parallelises by splitting the time window into PAR day-chunks and running them
# concurrently per index. Combine with throttle -1 and a big batch for max rate.
#
# SAFE BY DESIGN: same-host guard; preflight; gated prereq fixer; never drops;
# idempotent (preserves source _id); windowed; source is read-only.
#
set -uo pipefail
have(){ command -v "$1" >/dev/null 2>&1; }
have python3 || { echo "python3 required"; exit 1; }
hr(){ printf '\n----- %s -----\n' "$1"; }

LOCAL="https://localhost:9200"
echo "host: $(hostname)"

# ---- prompts ---------------------------------------------------------------
read -r -p "Source host/IP: "                  SRC_HOST
read -r -p "Source port [9200]: "              SRC_PORT; SRC_PORT=${SRC_PORT:-9200}
read -r -p "Source read user [admin]: "        SRC_USER; SRC_USER=${SRC_USER:-admin}
read -r -s -p "Source password: "              SRC_PASS; echo
read -r -s -p "Local admin password: "         LOC_PASS; echo
read -r -p "Index pattern [*]: "                PAT;  PAT=${PAT:-*}
read -r -p "Timestamp field [@timestamp]: "     TS;   TS=${TS:-@timestamp}
read -r -p "Import last how many days [7]: "     DAYS; DAYS=${DAYS:-7}
read -r -p "Parallel streams per index [4]: "    PAR;  PAR=${PAR:-4}
read -r -p "Throttle req/s PER stream (-1 = unlimited) [-1]: " RPS; RPS=${RPS:--1}
read -r -p "Scroll batch size [5000]: "          BATCH; BATCH=${BATCH:-5000}

SRC="https://${SRC_HOST}:${SRC_PORT}"
export SRC SRC_USER SRC_PASS TS DAYS PAR BATCH
cs(){ curl -sk -u "${SRC_USER}:${SRC_PASS}" -H 'Content-Type: application/json' "$SRC/$1" "${@:2}"; }
cl(){ curl -sk -u "admin:${LOC_PASS}"       -H 'Content-Type: application/json' "$LOCAL/$1" "${@:2}"; }
jget(){ python3 -c "import sys,json;d=json.load(sys.stdin);print(d$1)" 2>/dev/null; }

# ---- same-host guard -------------------------------------------------------
case "$SRC_HOST" in
  localhost|127.*|::1) echo "ABORT: source is loopback — that is THIS machine."; exit 1;;
esac
sip=$(getent hosts "$SRC_HOST" 2>/dev/null | awk '{print $1; exit}'); [ -z "$sip" ] && sip="$SRC_HOST"
for ip in $(hostname -I 2>/dev/null); do
  [ "$ip" = "$sip" ] && { echo "ABORT: source ($SRC_HOST -> $sip) is THIS machine. Run on the clone."; exit 1; }
done

WINQ=$(python3 -c 'import os,json;print(json.dumps({"range":{os.environ["TS"]:{"gte":"now-%sd"%os.environ["DAYS"]}}}))')
slice_query(){ LO="$1" HI="$2" python3 -c '
import os,json
ts=os.environ["TS"]; lo=int(os.environ["LO"]); hi=int(os.environ["HI"])
r={"gte":"now-%dd"%hi}
if lo>0: r["lt"]="now-%dd"%lo
print(json.dumps({"range":{ts:r}}))'; }
make_body(){ Q="$1" IDX="$2" python3 -c '
import os,json
print(json.dumps({"source":{"remote":{"host":os.environ["SRC"],"username":os.environ["SRC_USER"],
  "password":os.environ["SRC_PASS"],"socket_timeout":"5m","connect_timeout":"30s"},
  "index":os.environ["IDX"],"size":int(os.environ["BATCH"]),"query":json.loads(os.environ["Q"])},
  "dest":{"index":os.environ["IDX"]}}))'; }

# ---- connectivity ----------------------------------------------------------
hr "CONNECTIVITY"
sc=$(cs '' -o /dev/null -w '%{http_code}'); lc=$(cl '' -o /dev/null -w '%{http_code}')
echo "source $SRC -> HTTP ${sc:-none}   local -> HTTP ${lc:-none}"
[ "$sc" = 200 ] && [ "$lc" = 200 ] || { echo "Both must be 200."; exit 1; }

mapfile -t IDX < <(cs "_cat/indices/${PAT}?h=index" | grep -v '^\.' | sort)
[ "${#IDX[@]}" -gt 0 ] || { echo "No non-system indices match '$PAT'."; exit 1; }

# ---- preflight + prereq helper ---------------------------------------------
PF=""
do_preflight(){
  PF=$(cl "_reindex" -XPOST -d "{\"max_docs\":1,
    \"source\":{\"remote\":{\"host\":\"$SRC\",\"username\":\"$SRC_USER\",\"password\":\"$SRC_PASS\"},
      \"index\":\"${IDX[0]}\",\"size\":1},\"dest\":{\"index\":\"zz-weektest\"}}")
  local created; created=$(echo "$PF" | jget "['created']")
  cl "zz-weektest" -XDELETE -o /dev/null
  [ "${created:-0}" = "1" ]
}
fix_prereqs(){
  have docker || { echo "docker not here — add the lines manually and restart."; return 1; }
  local NODES; NODES=$(docker ps --format '{{.Names}}\t{{.Image}}' 2>/dev/null \
    | awk -F'\t' '$2 ~ /opensearchproject\/opensearch:/{print $1}')
  [ -n "$NODES" ] || { echo "no opensearch node containers found."; return 1; }
  # pick the node that actually bind-mounts opensearch.yml as a file
  local YML N
  for N in $NODES; do
    YML=$(docker inspect "$N" --format \
      '{{range .Mounts}}{{if eq .Destination "/usr/share/opensearch/config/opensearch.yml"}}{{.Source}}{{end}}{{end}}' 2>/dev/null)
    [ -n "$YML" ] && [ -f "$YML" ] && break
  done
  [ -n "$YML" ] && [ -f "$YML" ] || { echo "could not locate a bind-mounted opensearch.yml on any node."; return 1; }
  local need_wl=1 need_ssl=1
  grep -qE '^[[:space:]]*reindex\.remote\.whitelist'      "$YML" && need_wl=0
  grep -qE '^[[:space:]]*reindex\.ssl\.verification_mode' "$YML" && need_ssl=0
  if [ "$need_wl" = 0 ] && ! grep -q "${SRC_HOST}:${SRC_PORT}" "$YML"; then
    echo "whitelist line exists but lacks ${SRC_HOST}:${SRC_PORT} — merge by hand (comma-separated)."; return 1; fi
  local last; last=$(grep -vE '^[[:space:]]*$' "$YML" | tail -1)
  if [[ "$last" =~ ^[[:space:]] ]]; then
    echo "opensearch.yml ends inside an indented block; add manually (top-level) then restart $NODES:"
    [ "$need_wl"  = 1 ] && echo "  reindex.remote.whitelist: \"${SRC_HOST}:${SRC_PORT}\""
    [ "$need_ssl" = 1 ] && echo "  reindex.ssl.verification_mode: none"; return 1; fi
  echo; echo "Modify remote-reindex prereqs ON THIS HOST ($(hostname)):"
  echo "  file:   $YML   (backup ${YML}.bak)"; echo "  add:"
  [ "$need_wl"  = 1 ] && echo "      reindex.remote.whitelist: \"${SRC_HOST}:${SRC_PORT}\""
  [ "$need_ssl" = 1 ] && echo "      reindex.ssl.verification_mode: none"
  echo "  restart: $NODES"
  read -r -p "Proceed? [y/N]: " go; [ "$go" = y ] || { echo "Skipped."; return 1; }
  cp -n "$YML" "${YML}.bak"
  { echo ""; [ "$need_wl" = 1 ] && echo "reindex.remote.whitelist: \"${SRC_HOST}:${SRC_PORT}\""
    [ "$need_ssl" = 1 ] && echo "reindex.ssl.verification_mode: none"; } >> "$YML"
  echo "updated $YML; restarting $NODES"; docker restart $NODES >/dev/null
  printf "waiting for cluster"; for _ in $(seq 1 40); do
    s=$(cl '_cluster/health' | jget "['status']"); [ -n "${s:-}" ] && { echo " -> $s"; break; }; printf '.'; sleep 2; done
  return 0
}

hr "PREFLIGHT (copy 1 doc to prove the link works)"
if do_preflight; then echo "preflight OK"
elif echo "$PF" | grep -qiE 'whitelist|ssl|cert|handshake'; then
  echo "Blocked by a prerequisite:"; echo "$PF" | head -c 250; echo
  fix_prereqs || { echo "Not resolved. Fix opensearch.yml + restart, then re-run."; exit 1; }
  hr "PREFLIGHT (retry)"; do_preflight && echo "preflight OK" || { echo "Still failing:"; echo "$PF"|head -c 400; echo; exit 1; }
else echo "Preflight failed (not a prereq issue):"; echo "$PF" | head -c 600; echo; exit 1; fi

# ---- slice boundaries (days-ago ranges) ------------------------------------
mapfile -t SLICES < <(python3 -c '
import os,math
t=int(os.environ["DAYS"]); par=max(1,min(int(os.environ["PAR"]),t)); step=math.ceil(t/par)
s=0
while s<t:
    print(s, min(s+step,t)); s+=step')

# ---- plan ------------------------------------------------------------------
hr "PLAN: last ${DAYS}d | ${#SLICES[@]} parallel streams/index | ${RPS} req/s each | batch ${BATCH} (no drops)"
printf '%-45s %14s %14s\n' "index" "src this wk" "local this wk"
for i in "${IDX[@]}"; do
  sd=$(cs "$i/_count" -d "{\"query\":$WINQ}" | jget "['count']")
  ld=$(cl "$i" -o /dev/null -w '%{http_code}' | grep -q 200 && cl "$i/_count" -d "{\"query\":$WINQ}" | jget "['count']" || echo 0)
  printf '%-45s %14s %14s\n' "$i" "${sd:-?}" "${ld:-0}"
done
echo; echo "Note: ${#SLICES[@]} streams/index means up to ${RPS} req/s x ${#SLICES[@]} against the source."
read -r -p "Proceed? [y/N]: " ok; [ "$ok" = y ] || { echo "Aborted."; exit 0; }

poll_many(){ local ids=("$@") n=${#ids[@]}
  while :; do local cr=0 tot=0 nd=0 r c t d
    for x in "${ids[@]}"; do
      r=$(cl "_tasks/${x}"); d=$(echo "$r"|jget "['completed']")
      c=$(echo "$r"|jget "['task']['status']['created']"); t=$(echo "$r"|jget "['task']['status']['total']")
      [[ "${c:-}" =~ ^[0-9]+$ ]] && cr=$((cr+c)); [[ "${t:-}" =~ ^[0-9]+$ ]] && tot=$((tot+t))
      [ "$d" = True ] && nd=$((nd+1))
    done
    printf '\r    %s / %s docs  (%s/%s streams done)' "$cr" "$tot" "$nd" "$n"
    [ "$nd" = "$n" ] && { echo; break; }; sleep 5
  done; }

# ---- import ----------------------------------------------------------------
for i in "${IDX[@]}"; do
  hr "$i"
  cl "$i" -o /dev/null -w '%{http_code}' | grep -q 200 && \
    cl "$i/_settings" -XPUT -d '{"index":{"refresh_interval":"-1"}}' -o /dev/null   # pause refresh during load
  tids=()
  for s in "${SLICES[@]}"; do
    lo=${s% *}; hi=${s#* }
    q=$(slice_query "$lo" "$hi")
    body=$(make_body "$q" "$i")
    resp=$(cl "_reindex?wait_for_completion=false&requests_per_second=${RPS}" -XPOST -d "$body")
    tid=$(echo "$resp" | jget "['task']")
    if [ -n "${tid:-}" ]; then tids+=("$tid"); echo "    stream ${lo}-${hi}d -> $tid"
    else echo "    stream ${lo}-${hi}d did NOT start:"; echo "$resp" | head -c 200; echo; fi
  done
  [ "${#tids[@]}" -gt 0 ] && poll_many "${tids[@]}"
  cl "$i/_settings" -XPUT -d '{"index":{"refresh_interval":"1s"}}' -o /dev/null
  cl "$i/_refresh" -o /dev/null
  echo "  verify this week: source=$(cs "$i/_count" -d "{\"query\":$WINQ}" | jget "['count']")  local=$(cl "$i/_count" -d "{\"query\":$WINQ}" | jget "['count']")"
done
hr "DONE"
echo "Safe to re-run: overwrites matching _ids, adds new docs, no duplicates."
