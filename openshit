docker exec -it opensearch-node1 bash

export JAVA_HOME=/usr/share/opensearch/jdk
cd /usr/share/opensearch/plugins/opensearch-security/tools
chmod +x *.sh
CFG=/usr/share/opensearch/config

# Back up the current security config (all users with their existing hashes)
./securityadmin.sh -backup /tmp/secbackup -icl -nhnv \
  -cacert $CFG/root-ca.pem -cert $CFG/kirk.pem -key $CFG/kirk-key.pem

# Generate a hash for the new password
./hash.sh -p 'YourNewStrongPassword'
